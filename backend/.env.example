# Database
DATABASE_URL="postgresql://user:password@localhost:5432/leilao_imoveis?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Site URL (for SEO/Sitemap)
SITE_URL="https://www.seusite.com.br"

# reCAPTCHA v3 (get keys at https://www.google.com/recaptcha/admin)
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Scheduler (set to 'false' to disable automatic scraping)
ENABLE_SCHEDULER=true
