# =============================================================================
# Production Environment Variables - Backend
# =============================================================================
# Copy this file to .env and update values for your production environment
# =============================================================================

# Database (update with your credentials)
DATABASE_URL="postgresql://leilao_user:YOUR_SECURE_PASSWORD@localhost:5432/leilao_imoveis?schema=public"

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET="CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=production

# URLs (update with your domain)
FRONTEND_URL="https://www.seusite.com.br"
SITE_URL="https://www.seusite.com.br"

# reCAPTCHA v3 (get at https://www.google.com/recaptcha/admin)
RECAPTCHA_SECRET_KEY="YOUR_RECAPTCHA_SECRET_KEY"

# Scheduler
ENABLE_SCHEDULER=true
